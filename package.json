{
  "name": "dsh-qq-onebot-bridge",
  "version": "0.1.0",
  "description": "QQ 集成接入（qq-integration）：把 OneBot v11 实现（内置 Waylay 拉起）接到 DSH agent 的双向桥插件，控制台为独立进程（127.0.0.1:8880）",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mkiea/qq-integration.git"
  },
  "homepage": "https://github.com/mkiea/qq-integration#readme",
  "bugs": {
    "url": "https://github.com/mkiea/qq-integration/issues"
  },
  "bin": {
    "qq-control": "./control/bin/qq-control.mjs"
  },
  "scripts": {
    "control": "node control/bin/qq-control.mjs",
    "test": "node test/control-unit.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./extension": "./lib/extension.js",
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client",
    "control",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "NOTICE.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "qq",
    "onebot",
    "onebot-v11",
    "waylay",
    "napcat",
    "integration",
    "bridge",
    "speech-to-text",
    "asr",
    "debuggable",
    "tracing",
    "replay",
    "observability",
    "control-console"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "supportedRuntimeLines": [
      "0.1",
      "0.2"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "silk-wasm": "^3.7.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6 || ^0.1.1-rc.2 || ^0.1.2-rc.1 || ^0.1.5-rc.1 || ^0.2.0-rc.2 || ^0.2.1-rc.3",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "license": "MIT"
}
